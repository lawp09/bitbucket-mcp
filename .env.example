# Bitbucket MCP Server - Environment Configuration
# Copy this file to .env and fill in your credentials
# IMPORTANT: Never commit .env to version control

# Your Bitbucket account email
BITBUCKET_USERNAME=your-email@example.com

# Your Bitbucket API Token
# Create at: https://id.atlassian.com/manage-profile/security/api-tokens
# Required permissions: Repositories (Read/Write), Pull requests (Read/Write), Pipelines (Read)
BITBUCKET_TOKEN=your-api-token-here

# Your Bitbucket workspace name
BITBUCKET_WORKSPACE=your-workspace
